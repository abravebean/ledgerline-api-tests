{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET /bank/api/accounts/{id}/transactions",
  "type": "object",
  "required": [
    "account",
    "transactions"
  ],
  "additionalProperties": false,
  "properties": {
    "account": {
      "$ref": "#/definitions/account"
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "date",
          "description",
          "amountCents",
          "amount",
          "balanceAfterCents",
          "balanceAfter"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^txn_\\d+$"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string"
          },
          "amountCents": {
            "type": "integer"
          },
          "amount": {
            "$ref": "#/definitions/money"
          },
          "balanceAfterCents": {
            "type": "integer",
            "minimum": 0
          },
          "balanceAfter": {
            "$ref": "#/definitions/money"
          }
        }
      }
    }
  },
  "definitions": {
    "money": {
      "type": "string",
      "pattern": "^-?\\$\\d{1,3}(,\\d{3})*\\.\\d{2}$"
    },
    "account": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "number",
        "balanceCents",
        "balance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^acc_\\d+$"
        },
        "type": {
          "enum": [
            "checking",
            "savings"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "string",
          "pattern": "^••••\\d{4}$",
          "description": "Masked: only the last four digits are ever returned"
        },
        "balanceCents": {
          "type": "integer",
          "minimum": 0
        },
        "balance": {
          "$ref": "#/definitions/money"
        }
      }
    }
  }
}
